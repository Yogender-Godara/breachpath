# Template. Copy to .env and fill in: `cp env.example .env`. Never commit .env.

# --- FalkorDB ---
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
FALKORDB_PASSWORD=change-me

# --- LLM: OpenAI-compatible providers, called directly ---
# The order is the fallback order; a provider without a key or model is skipped.
# If a provider is unavailable, the agent run restarts on the next one. None usable = agent mode runs degraded (fast brains).
LLM_PROVIDERS=groq,openrouter
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Model per agent: chosen by spikes/llm_smoke.py (P1.4, results in docs/VERIFY_RESULTS.md)
# OpenRouter: tested. nemotron-3-super is the only free model that passed all 5 checks in every run.
MODEL_INVESTIGATOR_OPENROUTER=nvidia/nemotron-3-super-120b-a12b:free
MODEL_PLANNER_OPENROUTER=nvidia/nemotron-3-super-120b-a12b:free
MODEL_REPORTER_OPENROUTER=nvidia/nemotron-3-super-120b-a12b:free
# Groq: tested (spikes/llm_smoke.py passes checks 1, 3, 4, 5; about 0.7 s per call; 1000 requests/day, 8000 tokens/minute).
MODEL_INVESTIGATOR_GROQ=openai/gpt-oss-120b
MODEL_PLANNER_GROQ=openai/gpt-oss-120b
MODEL_REPORTER_GROQ=openai/gpt-oss-120b

LLM_TIMEOUT_S=30
LLM_MAX_WAIT_S=20
LLM_MAX_TOKENS=2000
LLM_MAX_TOKENS_REPORTER=2500
LLM_MAX_TOKENS_BASELINE=4000
LLM_CACHE=on
LLM_MAX_CALLS_PER_INCIDENT=20

# --- Graph / algorithm settings ---
MAX_HOPS=6
TOP_K_PATHS=20
MAX_ATTEMPTS=3
MAX_SIMULATIONS=6
SIMS_RESERVED_FOR_CODE=2
MAX_SANDBOXES=3
MAX_GRAPHS=20
NEED_USAGE_DAYS=30
QUERY_TIMEOUT_MS=2000
SANDBOX_TTL_HOURS=24
COLLATERAL_RECENT_DAYS=90

# --- MCP (stdio subprocess started by the worker) ---
MCP_COMMAND=python -m mcp_server.server
MCP_PROFILE=full

# --- Worker lock ---
LOCK_TTL_MS=60000
LOCK_HEARTBEAT_S=15

# --- Public demo protection ---
DEMO_TOKEN=change-me
RATE_LIMIT_PER_MIN=10
MAX_ACTIVE_AGENT=2
