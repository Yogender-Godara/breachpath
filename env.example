# Template. Copy to .env and fill in: `cp env.example .env`. Never commit .env.

# --- FalkorDB ---
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
FALKORDB_PASSWORD=change-me

# --- LLM providers (OpenAI-compatible). A provider with no key is skipped. ---
LLM_PROVIDERS=groq,openrouter,mistral
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Model per agent per provider: chosen at kickoff by spikes/llm_smoke.py (P1.4)
MODEL_INVESTIGATOR_GROQ=
MODEL_PLANNER_GROQ=
MODEL_REPORTER_GROQ=
MODEL_INVESTIGATOR_OPENROUTER=
MODEL_PLANNER_OPENROUTER=
MODEL_REPORTER_OPENROUTER=
MODEL_INVESTIGATOR_MISTRAL=
MODEL_PLANNER_MISTRAL=
MODEL_REPORTER_MISTRAL=

LLM_TIMEOUT_S=30
LLM_MAX_TOKENS=2000
LLM_CACHE=on

# --- Graph / algorithm settings ---
MAX_HOPS=6
TOP_K_PATHS=20
MAX_ATTEMPTS=3
MAX_SIMULATIONS=6
MAX_SANDBOXES=3
MAX_GRAPHS=20
NEED_USAGE_DAYS=30
QUERY_TIMEOUT_MS=2000
SANDBOX_TTL_HOURS=24
COLLATERAL_RECENT_DAYS=90

# --- MCP (stdio subprocess started by the worker) ---
MCP_COMMAND=python -m mcp_server.server
MCP_PROFILE=full

# --- Worker lock ---
LOCK_TTL_MS=60000
LOCK_HEARTBEAT_S=15

# --- Public demo protection ---
DEMO_TOKEN=change-me
RATE_LIMIT_PER_MIN=10
MAX_ACTIVE_AGENT=2
